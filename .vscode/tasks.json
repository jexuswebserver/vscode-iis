// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"problemMatcher": "$tsc",
			"isBackground": false,
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": "$ts-webpack-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": {
				"kind": "build"
			}
		},
		{
			"type": "npm",
			"script": "watch-tests",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"presentation": {
				"reveal": "never",
				"group": "watchers"
			},
			"group": "build"
		},
		{
			"label": "tasks: watch-tests",
			"dependsOn": [
				"npm: watch",
				"npm: watch-tests"
			],
			"problemMatcher": []
		},
		{
			"label": "dotnet: build language server",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"-c",
				"Debug",
				"JexusManager/IIS.LanguageServer/IIS.LanguageServer.csproj"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "tasks: build-all",
			"dependsOn": [
				"dotnet: build language server",
				"npm: compile"
			],
			"problemMatcher": []
		},
		{
			"label": "tasks: watch-all-tests",
			"dependsOn": [
				"dotnet: build language server",
				"npm: watch",
				"npm: watch-tests"
			],
			"problemMatcher": []
		}
	]
}
